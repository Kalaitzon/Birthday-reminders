# ─── Frontend (φαίνονται στον browser — μόνο δημόσια keys εδώ) ───────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Backend / cron (ΜΥΣΤΙΚΑ — ποτέ με πρόθεμα VITE_) ────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Birthday <onboarding@resend.dev>

# Πού να φτάνουν οι υπενθυμίσεις. Προαιρετικό — αν λείπει, στέλνονται
# στο email με το οποίο συνδέεσαι. Χρήσιμο όταν το email σύνδεσης
# διαφέρει από αυτό που θέλεις να λαμβάνει.
NOTIFY_EMAIL=

# Τυχαίο μυστικό για να μην μπορεί κανείς άλλος να καλέσει το cron.
# Φτιάξ' το με:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
