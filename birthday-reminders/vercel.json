{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/notify?slot=eve", "schedule": "59 20 * * *" },
    { "path": "/api/cron/notify?slot=noon", "schedule": "0 9 * * *" }
  ]
}
